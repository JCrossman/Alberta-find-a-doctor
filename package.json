{
  "name": "alberta-find-a-doctor-mcp",
  "version": "0.1.0",
  "description": "A read-only MCP server for finding Alberta clinics, physicians, and nurse practitioners.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "alberta-find-a-doctor-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test && npm run build && npm run smoke",
    "dev": "tsx src/index.ts",
    "prepack": "npm run build",
    "smoke": "node scripts/stdio-smoke.mjs",
    "smoke:live": "npm run build && node scripts/live-smoke.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JCrossman/Alberta-find-a-doctor.git"
  },
  "bugs": {
    "url": "https://github.com/JCrossman/Alberta-find-a-doctor/issues"
  },
  "homepage": "https://github.com/JCrossman/Alberta-find-a-doctor#readme",
  "keywords": [
    "alberta",
    "doctor",
    "clinic",
    "mcp",
    "model-context-protocol",
    "primary-care"
  ],
  "author": "Jeremy Crossman",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "tsx": "4.21.0",
    "typescript": "7.0.2",
    "vitest": "4.1.2"
  }
}
